%% Casos de uso — Fundación Manos Unidas de Dios
%% Actores FUERA del sistema = flechas directas a cada caso de uso
%% Módulos en cajas · vertical · Coordinador IZQ · Junta DER
%% https://mermaid.live

flowchart LR

    C(("Coordinador\nadministrativo"))

    subgraph Sistema["Sistema Historia Clínica — Fundación Manos Unidas de Dios"]
        direction TB

        subgraph M_FCons["Fichas clínicas · consulta (Junta y Coordinador)"]
            direction LR
            UC_Inicio(["Ver página de inicio"])
            UC_Listar(["Consultar listado de fichas"])
            UC_Abrir(["Abrir ficha completa"])
            UC_Explorar(["Explorar apartados del formulario"])
            UC_ConsultarAp(["Consultar datos por apartado"])
        end

        subgraph M_OCons["Operación · consulta (Junta y Coordinador)"]
            direction LR
            UC_Calendario(["Consultar calendario de citas"])
            UC_VerSignos(["Consultar signos vitales"])
            UC_VerNotas(["Consultar notas de enfermería"])
            UC_Demo(["Ver demo modelo 3D"])
        end

        subgraph M_FEdit["Fichas clínicas · edición (solo Coordinador)"]
            direction LR
            UC_Crear(["Crear nueva ficha clínica"])
            UC_Actualizar(["Actualizar ficha completa"])
            UC_Sync(["Guardar ficha en servidor"])
            UC_EditarAp(["Editar apartado individual"])
            UC_IngresoSec(["Diligenciar ingreso por secciones"])
        end

        subgraph M_Valor["Valoración clínica (solo Coordinador)"]
            direction LR
            UC_Datos(["Registrar datos de ingreso"])
            UC_Valor(["Registrar valoración y escalas"])
            UC_Exam(["Registrar examen físico y mental"])
            UC_Firmas(["Registrar firmas y aprobaciones"])
            UC_Modelo3D(["Marcar modelo corporal 3D"])
        end

        subgraph M_OEdit["Operación · edición (solo Coordinador)"]
            direction LR
            UC_Agendar(["Agendar cita médica"])
            UC_Finalizar(["Marcar cita como finalizada"])
            UC_Signos(["Registrar signos vitales por turno"])
            UC_Nota(["Registrar nota de enfermería"])
        end

        subgraph M_Auth["Autenticación"]
            direction LR
            UC_Login(["Iniciar sesión"])
            UC_Logout(["Cerrar sesión"])
        end

        M_FCons ~~~ M_OCons
        M_OCons ~~~ M_FEdit
        M_FEdit ~~~ M_Valor
        M_Valor ~~~ M_OEdit
        M_OEdit ~~~ M_Auth
    end

    J(("Junta\ndirectiva\n(solo consulta)"))

    NotaJunta["Junta solo visualiza:\n• Sesión · fichas · calendario\n• Signos y notas (lectura)\n• Demo 3D · valoración vía ficha\n—\nNo agenda citas ni registra datos"]

    C ~~~ Sistema ~~~ J
    J ~~~ NotaJunta

